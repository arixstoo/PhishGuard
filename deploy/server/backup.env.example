# /etc/phishguard/backup.env (root, 0600) — jamais commité. Étape 6.4.
# Clé publique age (age-keygen sur votre poste ; la clé privée n'est jamais sur le serveur).
PHISHGUARD_BACKUP_AGE_RECIPIENT=
# Destination rclone hors du serveur (rclone config), ex. b2:phishguard-backups/sqlite
PHISHGUARD_BACKUP_RCLONE_REMOTE=
# Rotation des copies locales, en jours.
PHISHGUARD_BACKUP_KEEP_DAYS=14
