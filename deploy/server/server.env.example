# /opt/phishguard/shared/server.env (deploy:deploy, 0600) — jamais commité.
# Lu par docker compose (interpolation de compose.prod.yml) et par phishguard-deploy.
# Copié par bootstrap.sh ; à remplir avant le premier déploiement (docs/deployment.md).

# Nom de l'origine, résolu vers ce serveur (enregistrement A), ex. un sous-domaine
# DuckDNS gratuit : phishguard-origin.duckdns.org. Caddy y obtient le certificat.
PHISHGUARD_ORIGIN_HOST=

# Secret partagé avec le projet Vercel (variable PHISHGUARD_ORIGIN_SECRET, « Sensitive ») :
#   openssl rand -hex 32
# 64 caractères hexadécimaux, refusé sinon. Rotation : docs/deployment.md.
PHISHGUARD_ORIGIN_SECRET=

# Contact Let's Encrypt (avis d'expiration de certificat).
PHISHGUARD_ACME_EMAIL=

# Origines navigateur autorisées (extension publiée, page web), jamais * :
# PHISHGUARD_API_CORS_ALLOWED_ORIGINS=chrome-extension://<identifiant>
PHISHGUARD_API_CORS_ALLOWED_ORIGINS=

# Threat Intelligence : false par défaut (l'URL part chez des tiers). Clés dans
# /opt/phishguard/shared/api.env (0600), jamais ici.
PHISHGUARD_API_THREAT_INTEL_ENABLED=false

# Uptime Kuma (étape 6.4) : « monitoring » pour le lancer avec l'API.
COMPOSE_PROFILES=monitoring
