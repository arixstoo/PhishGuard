# Scripts shell exécutés dans des conteneurs et sur la CI Linux : toujours en LF.
*.sh text eol=lf
Dockerfile text eol=lf

# Données exportées depuis Python (make extension-data) : ne pas modifier à la main.
extension/src/generated/*.json linguist-generated=true
extension/test/fixtures/python-parity.json linguist-generated=true

# Publication signée de test (étape 6.8) : octets exacts, jamais de conversion de fins de ligne.
extension/test/fixtures/signed-release/* -text
