{
  "name": "phishguard-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Extension PhishGuard (Chrome MV3) : analyse locale des URLs, sans envoi de données.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "build:e2e": "node build.mjs --test --stub-model",
    "test:e2e": "npm run build:e2e && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
