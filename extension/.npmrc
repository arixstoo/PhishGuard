# Durcissement de la chaîne d'approvisionnement (étape 5.2, docs/extension-design.md).
# Aucun script d'installation n'est exécuté : une dépendance compromise ne peut pas
# lancer de code à l'installation (esbuild fournit son binaire par une dépendance
# optionnelle, sans script).
ignore-scripts=true
# Versions exactes dans package.json ; package-lock.json fige l'arbre et les empreintes.
save-exact=true
engine-strict=true
fund=false
audit-level=moderate
