# Même mise en forme dans tous les éditeurs (ruff formate le Python, ceci couvre le reste).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,mjs,js,json,yml,yaml,toml,html,css}]
indent_size = 2

[*.md]
# Deux espaces en fin de ligne = saut de ligne en Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
