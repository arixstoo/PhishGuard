{
  "$defs": {
    "AnalystView": {
      "additionalProperties": false,
      "description": "Ce que voit un analyste, ou l'utilisateur qui déplie « Détails techniques ».\n\nLes signaux bruts des sources restent dans ``signals`` (contrat 1.0.0) ; la vue\nanalyste ajoute le modèle, son explication, la fusion et les versions.",
      "properties": {
        "explanation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExplanationOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fusion": {
          "$ref": "#/$defs/FusionOut"
        },
        "model": {
          "$ref": "#/$defs/ModelOut"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Versions du schéma, du modèle, de la fusion, des gabarits, de l'explication",
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "model",
        "fusion",
        "versions"
      ],
      "title": "AnalystView",
      "type": "object"
    },
    "ContributionOut": {
      "additionalProperties": false,
      "description": "Part d'une source (ou du modèle) dans le score fusionné (étape 2.10).",
      "properties": {
        "points": {
          "maximum": 100,
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Risk",
          "type": "number"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "source",
        "risk",
        "weight",
        "points"
      ],
      "title": "ContributionOut",
      "type": "object"
    },
    "ExplanationOut": {
      "additionalProperties": false,
      "description": "Décomposition du score brut du modèle : ``base_value + somme des contributions``.\n\n``features`` (URL) les donne toutes, de la plus forte en valeur absolue à la plus\nfaible ; ``terms_phishing`` et ``terms_safe`` (texte) les mots les plus influents dans\nchaque sens.",
      "properties": {
        "base_value": {
          "title": "Base Value",
          "type": "number"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/FeatureOut"
          },
          "title": "Features",
          "type": "array"
        },
        "method": {
          "enum": [
            "tree_shap",
            "linear"
          ],
          "title": "Method",
          "type": "string"
        },
        "output": {
          "description": "Score brut du modèle, dans ``space``",
          "title": "Output",
          "type": "number"
        },
        "space": {
          "enum": [
            "log_odds",
            "probability",
            "margin"
          ],
          "title": "Space",
          "type": "string"
        },
        "terms_phishing": {
          "items": {
            "$ref": "#/$defs/TermOut"
          },
          "maxItems": 10,
          "title": "Terms Phishing",
          "type": "array"
        },
        "terms_safe": {
          "items": {
            "$ref": "#/$defs/TermOut"
          },
          "maxItems": 10,
          "title": "Terms Safe",
          "type": "array"
        }
      },
      "required": [
        "method",
        "space",
        "base_value",
        "output"
      ],
      "title": "ExplanationOut",
      "type": "object"
    },
    "FeatureOut": {
      "additionalProperties": false,
      "description": "Une feature du modèle URL : sa valeur et sa contribution SHAP (étape 3.1).",
      "properties": {
        "contribution": {
          "title": "Contribution",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "contribution"
      ],
      "title": "FeatureOut",
      "type": "object"
    },
    "FusionOut": {
      "additionalProperties": false,
      "description": "Détail de la fusion : probabilité, seuils, règle dure, contributions.",
      "properties": {
        "contributions": {
          "items": {
            "$ref": "#/$defs/ContributionOut"
          },
          "title": "Contributions",
          "type": "array"
        },
        "hard_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Rule"
        },
        "ignored": {
          "description": "Sources non utilisables",
          "items": {
            "type": "string"
          },
          "title": "Ignored",
          "type": "array"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "thresholds": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Thresholds",
          "type": "object"
        }
      },
      "required": [
        "probability",
        "thresholds"
      ],
      "title": "FusionOut",
      "type": "object"
    },
    "ModelOut": {
      "additionalProperties": false,
      "description": "Sortie du modèle local, avant la fusion.",
      "properties": {
        "calibrated": {
          "title": "Calibrated",
          "type": "boolean"
        },
        "probability": {
          "description": "Après calibration (étape 2.10)",
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "raw_score": {
          "description": "Probabilité (URL) ou marge du SVM (texte)",
          "title": "Raw Score",
          "type": "number"
        },
        "thresholds": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Seuils de décision du modèle seul, sur son score brut",
          "title": "Thresholds",
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "raw_score",
        "probability",
        "calibrated"
      ],
      "title": "ModelOut",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "description": "Une raison du verdict, en langage simple (étape 3.2).\n\nLe ``code`` est stable : un client peut s'en servir pour traduire ou choisir une\nicône, avec les variables de ``params``. Le ``message`` est déjà rédigé dans la langue\nde la réponse et peut être reformulé d'une version à l'autre. C'est du **texte\nbrut** : à insérer comme texte, jamais comme HTML.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "description": "Variables de la phrase (marque, nombre de jours…)",
          "title": "Params",
          "type": "object"
        },
        "points": {
          "description": "Part du score attribuée à cette raison",
          "maximum": 100,
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "code",
        "source",
        "points",
        "message"
      ],
      "title": "Reason",
      "type": "object"
    },
    "SignalOut": {
      "additionalProperties": false,
      "description": "Réponse d'une source de Threat Intelligence (étapes 2.4 à 2.7).",
      "properties": {
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Risk",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/SignalStatus"
        }
      },
      "required": [
        "status",
        "risk",
        "latency_ms"
      ],
      "title": "SignalOut",
      "type": "object"
    },
    "SignalStatus": {
      "enum": [
        "ok",
        "error",
        "skipped",
        "timeout"
      ],
      "title": "SignalStatus",
      "type": "string"
    },
    "TechniqueOut": {
      "additionalProperties": false,
      "description": "Technique MITRE ATT&CK illustrée par la détection (étape 2.11).",
      "properties": {
        "id": {
          "pattern": "^T\\d{4}(\\.\\d{3})?$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "tactic": {
          "minLength": 1,
          "title": "Tactic",
          "type": "string"
        },
        "url": {
          "pattern": "^https://attack\\.mitre\\.org/techniques/",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "tactic",
        "url",
        "reason"
      ],
      "title": "TechniqueOut",
      "type": "object"
    },
    "TermOut": {
      "additionalProperties": false,
      "description": "Un mot du message et sa contribution au score (étape 3.3), nettoyé comme les\nraisons : à afficher comme texte, jamais comme HTML.",
      "properties": {
        "contribution": {
          "title": "Contribution",
          "type": "number"
        },
        "term": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term",
        "contribution"
      ],
      "title": "TermOut",
      "type": "object"
    }
  },
  "$id": "https://github.com/arixstoo/PhishGuard/schema/analysis-response/1.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Réponse d'une analyse, quel que soit le canal (URL, SMS, email).",
  "properties": {
    "advice": {
      "description": "Conseil d'action, toujours présent, selon le canal et le verdict",
      "maxLength": 300,
      "minLength": 1,
      "title": "Advice",
      "type": "string"
    },
    "analyst": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalystView"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Détails techniques (étape 3.4) : à n'afficher qu'à la demande"
    },
    "channel": {
      "enum": [
        "url",
        "email",
        "sms",
        "messaging"
      ],
      "title": "Channel",
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "enrichment": {
      "enum": [
        "used",
        "skipped"
      ],
      "title": "Enrichment",
      "type": "string"
    },
    "fusion_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Fusion Version",
      "type": "string"
    },
    "language": {
      "default": "fr",
      "description": "Langue des phrases",
      "enum": [
        "fr",
        "en",
        "ar"
      ],
      "title": "Language",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "mitre": {
      "items": {
        "$ref": "#/$defs/TechniqueOut"
      },
      "title": "Mitre",
      "type": "array"
    },
    "model_version": {
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "reasons": {
      "description": "Au plus trois raisons, de la plus forte",
      "items": {
        "$ref": "#/$defs/Reason"
      },
      "maxItems": 3,
      "title": "Reasons",
      "type": "array"
    },
    "schema_version": {
      "default": "1.2.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "integer"
    },
    "signals": {
      "additionalProperties": {
        "$ref": "#/$defs/SignalOut"
      },
      "description": "Une entrée par source interrogée",
      "title": "Signals",
      "type": "object"
    },
    "verdict": {
      "enum": [
        "safe",
        "suspicious",
        "phishing"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "channel",
    "verdict",
    "score",
    "confidence",
    "reasons",
    "signals",
    "mitre",
    "model_version",
    "fusion_version",
    "enrichment",
    "latency_ms",
    "advice"
  ],
  "title": "AnalysisResponse",
  "type": "object"
}
