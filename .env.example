# Copier vers .env (jamais commité) et remplir les valeurs.
# Une valeur vide désactive la source correspondante : le projet démarre sans aucune clé.
# En cas de fuite d'une clé : la révoquer et en générer une nouvelle (voir docs/secrets.md).

# Collecte des flux (scripts/fetch_feeds.py)
URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
# Chiffrement des archives GitHub (même valeur que le secret du dépôt)
ARCHIVE_PASSPHRASE=

# Threat Intelligence (module 2, chargées par src/phishguard/config.py)
# Google Safe Browsing : clé Google Cloud restreinte à la seule API Safe Browsing
GSB_API_KEY=
# VirusTotal : palier gratuit, usage non commercial uniquement
VT_API_KEY=
# urlscan.io : Settings > API Keys
URLSCAN_API_KEY=
# Soumettre un scan quand aucun n'existe (true/false, défaut false) : envoie l'URL complète
URLSCAN_SUBMIT=
# Visibilité des scans soumis : unlisted (défaut) ou private ; jamais public
URLSCAN_VISIBILITY=
# AbuseIPDB (facultatif) : réputation des adresses IP
ABUSEIPDB_API_KEY=

# Sans clé : RDAP et DNS sont toujours actifs. Certificate Transparency (crt.sh), lent
# et instable, s'active avec CRTSH_ENABLED=true (défaut false).
CRTSH_ENABLED=
