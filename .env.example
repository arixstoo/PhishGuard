# Copier vers .env (jamais commité) et remplir les valeurs.
# Une valeur vide désactive la source correspondante : le projet démarre sans aucune clé.
# En cas de fuite d'une clé : la révoquer et en générer une nouvelle (voir docs/secrets.md).

# Collecte des flux (scripts/fetch_feeds.py)
URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
# Chiffrement des archives GitHub (même valeur que le secret du dépôt)
ARCHIVE_PASSPHRASE=

# Threat Intelligence (module 2, chargées par src/phishguard/config.py)
# Google Safe Browsing : clé Google Cloud restreinte à la seule API Safe Browsing
GSB_API_KEY=
# VirusTotal : palier gratuit, usage non commercial uniquement
VT_API_KEY=
# urlscan.io : Settings > API Keys
URLSCAN_API_KEY=
# Soumettre un scan quand aucun n'existe (true/false, défaut false) : envoie l'URL complète
URLSCAN_SUBMIT=
# Visibilité des scans soumis : unlisted (défaut) ou private ; jamais public
URLSCAN_VISIBILITY=
# AbuseIPDB (facultatif) : réputation des adresses IP
ABUSEIPDB_API_KEY=

# Sans clé : RDAP et DNS sont toujours actifs. Certificate Transparency (crt.sh), lent
# et instable, s'active avec CRTSH_ENABLED=true (défaut false).
CRTSH_ENABLED=

# API (module 4, chargée par src/phishguard/api/settings.py). Toutes facultatives :
# les valeurs par défaut sont sûres (aucun proxy cru, Threat Intelligence désactivée).
# PHISHGUARD_API_MODELS_DIR=models
# PHISHGUARD_API_DATABASE_PATH=data/api/phishguard.sqlite3
# PHISHGUARD_API_DOCS_ENABLED=true
# Interroger les sources de Threat Intelligence quand le client le demande (défaut false)
# PHISHGUARD_API_THREAT_INTEL_ENABLED=false
# Limites de débit (syntaxe « 30/minute », « 5/second;100/hour »)
# PHISHGUARD_API_RATE_LIMIT_ANONYMOUS=30/minute
# PHISHGUARD_API_RATE_LIMIT_AUTHENTICATED=300/minute
# PHISHGUARD_API_RATE_LIMIT_REJECTED=10/minute
# Plusieurs workers : stockage partagé, sinon chaque worker accorde le quota entier
# PHISHGUARD_API_RATE_LIMIT_STORAGE_URI=redis://localhost:6379
# Réseaux du proxy inverse dont X-Forwarded-For est cru (vide : en-tête ignoré)
# PHISHGUARD_API_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
